{
  "name": "xylem-landscape",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/birthday-rewards",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/reset-daily-stock",
      "schedule": "0 17 * * *"
    }
  ]
}
