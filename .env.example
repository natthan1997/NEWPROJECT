# ==========================================
# 1. Database & Authentication (Supabase)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ==========================================
# 2. File Storage (Cloudflare R2)
# ==========================================
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ==========================================
# 3. Application Settings
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
NEXT_PUBLIC_ENABLE_LINE_LOGIN="false"
WEBHOOK_SECRET="webhook_secret_dev_123"

# ==========================================
# 4. Social Login & Notifications (LINE)
# ==========================================
# LINE Login (configure in Supabase Auth -> Providers -> LINE)
LINE_CHANNEL_ID="your-line-channel-id"
LINE_CHANNEL_SECRET="your-line-channel-secret"

# LINE Messaging API (for push notifications)
LINE_MESSAGING_API_TOKEN="your-line-messaging-api-channel-access-token"
LINE_ACTION_SECRET="your-long-random-line-action-secret"

# Custom LINE OAuth callback (when not using Supabase LINE provider)
LINE_REDIRECT_URI="http://localhost:3000/api/auth/line/callback"
LINE_FRONTEND_SUCCESS_URL="http://localhost:3000/auth/success"
LINE_FRONTEND_ERROR_URL="http://localhost:3000/login"
LINE_PASSWORD_SECRET="your-very-strong-random-secret"

# ==========================================
# 5. Email Service (Gmail SMTP)
# ==========================================
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM_NAME="XYL Studio"

# ==========================================
# 6. Payment Gateway (Stripe)
# ==========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ==========================================
# 7. Other Payment Gateways (Optional)
# ==========================================
# C2P_MERCHANT_ID=your_merchant_id
# C2P_SECRET_KEY=your_secret_key